package betty-blocks:gunzip@1.0.0;

interface gunzip {
    // Parameter names match the option names in function.json one-to-one (bb functions validate
    // does not check this). `data` is an option so that a variable that is empty at run time
    // is handled as empty input instead of failing before the step runs.
    // `output-encoding` is a plain string with a Select option in function.json, the same shape as
    // data-api-request's `sort-order`. Only strings pass between steps, so binary data never
    // leaves this step. Data is always base64: gzip data starts with the bytes 1f 8b, which are never valid UTF-8, so it cannot arrive as text.
    gunzip: func(
        data: option<string>,
        output-encoding: string,
    ) -> result<string, string>;
}

world main {
    export gunzip;
}
