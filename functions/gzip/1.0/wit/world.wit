package betty-blocks:gzip@1.0.0;

interface gzip {
    // Parameter names match the option names in function.json one-to-one (bb functions validate
    // does not check this). `data` is an option so that a variable that is empty at run time
    // is handled as empty input instead of failing before the step runs.
    // `input-encoding` is a plain string with a Select option in function.json, the same shape as
    // data-api-request's `sort-order`. Only strings pass between steps, so binary data never
    // leaves this step. The result is always base64: gzip output starts with the bytes 1f 8b, which are never valid UTF-8.
    gzip: func(
        data: option<string>,
        input-encoding: string,
    ) -> result<string, string>;
}

world main {
    export gzip;
}
