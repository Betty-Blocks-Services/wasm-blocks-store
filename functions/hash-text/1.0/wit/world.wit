package betty-blocks:hash-text@1.0.0;

interface hash-text {
    // Parameter names match the option names in function.json one-to-one (bb functions validate
    // does not check this). `text` and `secret-key` are options so that a variable that is empty
    // at run time arrives as empty input instead of failing before the step runs; the hash of
    // empty text is a valid hash. `algorithm` and `output-encoding` are Select options in
    // function.json, received as a plain `string` holding the chosen option's `value`.
    hash-text: func(
        algorithm: string,
        text: option<string>,
        secret-key: option<string>,
        output-encoding: string,
    ) -> result<string, string>;
}

world main {
    export hash-text;
}
